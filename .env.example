# Browser-visible build configuration. Never put secrets in VITE_* values.
VITE_API_URL=https://your-django-api.up.railway.app
# Exact origin allowed for signed media. The default is shown explicitly so
# preview/prod inventories can compare names and values without a hidden fallback.
VITE_MEDIA_ORIGIN=https://storage.googleapis.com
VITE_REF_MAX_DIM=2048

# Local Vite proxy target; not exposed to the browser bundle.
DJANGO_DEV_ORIGIN=http://127.0.0.1:8000
