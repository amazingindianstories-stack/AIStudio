# Next.js / Vercel: transport configuration only. Never add database, cloud,
# provider, authentication-signing, worker or migration credentials here.
# Configure the actual HTTPS Django API origin on the frontend service.
DJANGO_API_ORIGIN=https://api.example.invalid

# Local transport qualification only (the isolated runner supplies these).
# DJANGO_API_ORIGIN=http://127.0.0.1:8000
# DJANGO_API_ALLOW_LOCAL=1

# Optional browser reference preview cap; original master downloads stay intact.
# NEXT_PUBLIC_REF_MAX_DIM=2048
