# Next.js / Vercel: transport configuration only. Never add database, cloud,
# provider, authentication-signing, worker or migration credentials here.
# Configure the actual HTTPS Django API origin on the frontend service.
DJANGO_API_ORIGIN=https://api.example.invalid
# Server-only value the middleware sends to the Django ingress gateway (48+ characters).
# Required: without it every /api request returns 503. Never expose it as NEXT_PUBLIC_*.
GOAL4_PRIVATE_INGRESS_SECRET=

# Local development only (scripts/dev/browser-harness.py and local/veevee.sh set these).
# DJANGO_API_ORIGIN=http://127.0.0.1:8000
# DJANGO_API_ALLOW_LOCAL=1

# Optional browser reference preview cap; original master downloads stay intact.
# NEXT_PUBLIC_REF_MAX_DIM=2048

# Optional server-only Edge Config (now Global Config) read connection string.
# Set the boolean veevee_maintenance in that store. Unconfigured/unavailable means OFF.
# Keep this in Vercel only, never NEXT_PUBLIC_*; see the release runbook.
EDGE_CONFIG=
