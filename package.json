{
  "name": "veevee-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "postcss": "$postcss",
    "uuid": "^11.1.1",
    "sharp": "$sharp"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "node scripts/run-unit-tests.mjs",
    "test:db": "tsx --tsconfig jsconfig.json --test src/lib/cost-basis-db.integration.js src/lib/feed-scope-db.integration.js src/lib/generation-health-db.integration.js src/lib/login-throttle-db.integration.js src/lib/stuck-omni-db.integration.js",
    "db:push": "drizzle-kit push",
    "db:migrate:cost-basis": "tsx scripts/migrate-cost-basis.js",
    "db:seed": "tsx scripts/seed.js",
    "db:optimize": "tsx scripts/optimize-history-indexes.js",
    "migrate:postgres:gcp": "tsx scripts/migrate-postgres-to-cloud-sql.js",
    "migrate:media:gcp": "tsx scripts/migrate-s3-to-gcs.js",
    "verify:media:gcp": "tsx scripts/verify-media-references-gcs.js",
    "media:thumbs": "tsx scripts/backfill-thumbnails.js",
    "sync:shiv-sati-storyboard": "tsx scripts/sync-shiv-sati-storyboard.js",
    "hf:login": "node scripts/hf-mcp-auth.mjs",
    "recover:videos": "tsx --tsconfig jsconfig.json scripts/recover-timed-out-videos.js",
    "reconcile:omni": "tsx --tsconfig jsconfig.json scripts/reconcile-stuck-omni.js",
    "eval:regression": "tsx --tsconfig jsconfig.json scripts/eval-regression.js",
    "export:flagged-fixtures": "tsx --tsconfig jsconfig.json scripts/export-flagged-fixtures.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1081.0",
    "@aws-sdk/s3-request-presigner": "^3.1097.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@google-cloud/cloud-sql-connector": "^1.11.2",
    "@google-cloud/storage": "^7.21.0",
    "@vercel/oidc": "^3.8.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^11.18.0",
    "google-auth-library": "^10.9.0",
    "lucide-react": "^0.469.0",
    "next": "^15.5.20",
    "pg": "^8.22.0",
    "postgres": "^3.4.9",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "recharts": "^3.9.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.20",
    "postcss": "^8.5.19",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.4"
  }
}
