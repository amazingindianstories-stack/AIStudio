# veevee's deployed API origin. Same value the frontend's NEXT_PUBLIC_API_URL
# points at once the Django split-deployment cutover happens (see CLAUDE.md);
# until then this is wherever the Next.js app is actually running.
VEEVEE_API_URL=https://your-veevee-deployment.example.com

# Must match DEPTH_WORKER_TOKEN set on the server (Vercel/Railway env vars).
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
DEPTH_WORKER_TOKEN=

# Cosmetic — shown on the admin/status pill's tooltip.
DEPTH_WORKER_LABEL="Rohit's Mac"

# Path to the neural-networks-workflow/video-depth-maps checkout — must
# contain both Video-Depth-Anything/ (with its checkpoints/ downloaded per
# that repo's own README) and yolov8n-seg.pt as siblings.
DEPTH_ASSETS_ROOT="/Users/ais4/Desktop/Rohit Chavda/Dev/neural-networks-workflow/video-depth-maps"

# Soft RAM cap in MB — see worker.py's RAM_LIMIT_MB comment for what this
# does and doesn't guarantee. 32000 = 32GB, comfortably under the 64GB
# machine this was scoped for while leaving headroom for everything else
# running on it. Raise to 48000 if that's too conservative in practice.
DEPTH_RAM_LIMIT_MB=32000
