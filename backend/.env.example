# Backend service environment inventory, NOT an automatically loaded dotenv file.
# Set values through each service's secret manager after target verification.
# API, generation, export and scheduler share reviewed DB/schema/storage contracts;
# give each service only the provider/worker credentials its role needs.
# All example values below are placeholders. No deployment has been performed.
DJANGO_SETTINGS_MODULE=config.settings.production
DATABASE_URL=postgresql://USER:PASSWORD@DATABASE_HOST:5432/DATABASE_NAME?sslmode=verify-full
# Mount the reviewed CA and append sslrootcert=/path/to/ca.pem if required.
# Django's libpq transport must be tested against the real target before cutover.
AUTH_SECRET=
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=api.example.invalid
DJANGO_BROWSER_ORIGINS=https://app.example.invalid
PUBLIC_APP_URL=https://app.example.invalid

# Native media storage: explicit backend; masters are never silently recompressed.
VEEVEE_MEDIA_BACKEND=gcs
GCP_MEDIA_BUCKET=
GCP_PROJECT_ID=
GCP_MEDIA_CDN_URL=
# GCS and optional Vertex use Google Application Default Credentials. Provision a
# workload identity or a mounted service-account credential file, never frontend.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-service-account.json
# GCP_SERVICE_ACCOUNT_EMAIL=  # Required for IAM-based signing without a local key.
# GCP_MEDIA_READ_FALLBACK_BUCKET=  # Reviewed legacy fallback, missing objects only.
# GCS_MIGRATION_READ_FALLBACK=1
# AWS_S3_BUCKET_NAME=
# AWS_REGION=us-east-1
# S3 uses its SDK credential chain; provision the backend service identity only.
# Local disposable qualification uses VEEVEE_MEDIA_BACKEND=filesystem and an
# explicit VEEVEE_MEDIA_ROOT scratch directory, supplied by its isolated harness.
VEEVEE_PROVIDER_MEDIA_HOSTS=
FFMPEG_BINARY=ffmpeg

# Provider keys: configure only on services that submit/poll the relevant work.
GOOGLE_API_KEY=
ARK_API_KEY=
# ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# SEEDREAM_MODEL=dola-seedream-5-0-pro-260628
# SEEDANCE_MODEL=dreamina-seedance-2-0-260128
# SEEDANCE_MODEL_FAST=dreamina-seedance-2-0-fast-260128
# SEEDANCE_MODEL_25=dreamina-seedance-2-5-260628
# SEEDANCE_IMAGE_ROLE=reference_image
# SEEDANCE_CALLBACK_URL=https://api.example.invalid/api/webhooks/seedance
SEEDANCE_CALLBACK_SECRET=
KLING_API=
# KLING_API_HOST=https://api-singapore.klingai.com
MAGNIFIC_API_KEY=
HIGGSFIELD_MCP_REFRESH_TOKEN=
HIGGSFIELD_MCP_CLIENT_ID=
# Central private storage persists refresh-token rotation; do not share a local
# token file across replicas. Optional upload allowlist supplements default hosts.
# HIGGSFIELD_UPLOAD_HOSTS=
# OMNI_USE_VERTEX=1
# GOOGLE_CLOUD_PROJECT=
BYTEPLUS_ACCESS_KEY_ID=
BYTEPLUS_SECRET_ACCESS_KEY=
# BYTEPLUS_ARK_REGION=ap-southeast-1
# BYTEPLUS_ARK_HOST=ark.ap-southeast-1.byteplusapi.com

# API/external depth/cron/admin setup authentication; use distinct strong secrets.
DEPTH_WORKER_TOKEN=
CRON_SECRET=
SET_TOKEN_SECRET=
ABLY_API_KEY=
# AGENT_LLM_MODEL=gemini-flash-latest
# AUDIO_TRANSCRIPTION_MODEL=gemini-2.5-flash

# Keep cost/quality switches at reviewed defaults. Changing best-of or judge
# settings may add billed requests; do not silently increase them during cutover.
# FACE_BEST_OF defaults to 2 where face judging applies; VIDEO_BEST_OF is opt-in.
# POST_CRISPEN=0
# MOCK_GENERATION and MOCK_ASSET_PROVIDER are disposable-qualification flags only;
# they must be absent or 0 in production. Never export them on the frontend.

# Optional migrated legacy export capability; distinct from generation/depth credentials.
# Leave unset unless a verified client needs scoped source/upload access.
EXPORT_WORKER_SECRET=REPLACE_WITH_DISTINCT_EXPORT_CAPABILITY

# Local data workflow only: fixtures | sanitized_snapshot | read_only_viewer.
# Reader mode blocks HTTP mutations, writer workers and migration commands.
# It does not replace verified read-only database/storage credentials.
LOCAL_DATA_MODE=fixtures
