# Veevee backend (Django) — copy to backend/.env and fill in.
# This points at the existing authoritative PostgreSQL database. Django owns
# migrations after catalog adoption; never run Drizzle schema changes against it.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Same value as the root app's DATABASE_URL.
DATABASE_URL=

# Match the frontend rollback API during the seven-day compatibility window.
AUTH_SECRET=
VEEVEE_SESSION_COOKIE=veevee_session

# The Vercel-hosted frontend origin(s), comma-separated, no trailing slash.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Keep 0 only for local development. Production defaults to two years.
SECURE_HSTS_SECONDS=0

# Railway: inject the service-account JSON as a sealed variable and materialize
# it outside the repository before start. Never commit the credential file.
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=
GCP_MEDIA_BUCKET=
GCP_MEDIA_CDN_URL=
MEDIA_BACKEND=gcs

CRON_SECRET=
SET_TOKEN_SECRET=

# Same value as the root app's DEPTH_WORKER_TOKEN — the local depth-map
# worker (depth-worker/) authenticates against whichever stack is actually
# serving /api/worker/depth/* for a given deployment, so both must agree.
DEPTH_WORKER_TOKEN=
