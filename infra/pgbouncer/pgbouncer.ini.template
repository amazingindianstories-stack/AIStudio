; Rendered by entrypoint.sh (envsubst); every ${VARIABLE} below is read from the service environment.
; The per-service server-connection budget lives here, in reviewed source: docs/operations/database-connections.md
; derives it. A pool larger than its budget cannot be created, so adding replicas or worker slots queues work
; (bounded by query_wait_timeout) instead of exhausting PostgreSQL.
;
; One alias per service. Each alias points at the same database and carries its own pool_size, max_db_connections
; and connect_query (the service's statement and idle-in-transaction timeouts, which PgBouncer cannot track per
; client because PostgreSQL does not report them). Pools are per (alias, role): the API, MCP and agent run as the
; API role, the generation worker, export worker and scheduler as worker roles, so the roles' row-level security
; and paid-budget functions (current_user) still apply per connection.
[databases]
veevee_api = host=${PGBOUNCER_UPSTREAM_HOST} port=${PGBOUNCER_UPSTREAM_PORT} dbname=railway pool_size=7 max_db_connections=7 connect_query='SET statement_timeout=30000; SET idle_in_transaction_session_timeout=30000'
veevee_mcp = host=${PGBOUNCER_UPSTREAM_HOST} port=${PGBOUNCER_UPSTREAM_PORT} dbname=railway pool_size=2 max_db_connections=2 connect_query='SET statement_timeout=30000; SET idle_in_transaction_session_timeout=30000'
veevee_agent = host=${PGBOUNCER_UPSTREAM_HOST} port=${PGBOUNCER_UPSTREAM_PORT} dbname=railway pool_size=2 max_db_connections=2 connect_query='SET statement_timeout=30000; SET idle_in_transaction_session_timeout=30000'
veevee_generation = host=${PGBOUNCER_UPSTREAM_HOST} port=${PGBOUNCER_UPSTREAM_PORT} dbname=railway pool_size=4 max_db_connections=4 connect_query='SET statement_timeout=60000; SET idle_in_transaction_session_timeout=60000'
veevee_export = host=${PGBOUNCER_UPSTREAM_HOST} port=${PGBOUNCER_UPSTREAM_PORT} dbname=railway pool_size=1 max_db_connections=1 connect_query='SET statement_timeout=120000; SET idle_in_transaction_session_timeout=60000'
veevee_scheduler = host=${PGBOUNCER_UPSTREAM_HOST} port=${PGBOUNCER_UPSTREAM_PORT} dbname=railway pool_size=1 max_db_connections=1 connect_query='SET statement_timeout=120000; SET idle_in_transaction_session_timeout=60000'
; Used only by auth_query below (one login lookup per new client connection).
veevee_auth = host=${PGBOUNCER_UPSTREAM_HOST} port=${PGBOUNCER_UPSTREAM_PORT} dbname=railway pool_size=1 max_db_connections=1

[pgbouncer]
listen_addr = 0.0.0.0
listen_port = ${PGBOUNCER_PORT}
unix_socket_dir =
pool_mode = transaction
; Transaction pooling cannot keep session state. The backend uses none (docs/operations/database-connections.md);
; psycopg prepared statements are off in Django, and PgBouncer 1.21+ would otherwise translate them.
max_prepared_statements = 0
; Clients (Django threads, with CONN_MAX_AGE) are cheap here; only server connections are budgeted.
max_client_conn = 400
min_pool_size = 0
reserve_pool_size = 0
; A client waits at most this long for a server connection, then gets an error it can retry (never a hang).
query_wait_timeout = 15
server_idle_timeout = 60
server_lifetime = 3600
server_connect_timeout = 5
server_login_retry = 1
; Backstops when a service misbehaves; the connect_query timeouts above are the first line.
query_timeout = 180
idle_transaction_timeout = 90
server_reset_query =
server_check_delay = 30
; application_name is tracked per client by default, so pg_stat_activity names the service that last used a server.
ignore_startup_parameters = extra_float_digits
log_connections = 0
log_disconnections = 0
log_stats = 1
stats_period = 60

; Clients log in with their own PostgreSQL role and password, verified by auth_query against the live role (no
; password list to maintain, rotation needs no PgBouncer change); PgBouncer then logs in to PostgreSQL as that role.
auth_type = scram-sha-256
auth_user = pgbouncer_auth
auth_query = SELECT usename, passwd FROM pgbouncer.get_auth($1)
auth_dbname = veevee_auth
auth_file = ${PGBOUNCER_AUTH_FILE}
admin_users = pgbouncer_admin

client_tls_sslmode = ${PGBOUNCER_CLIENT_TLS_MODE}
client_tls_key_file = ${PGBOUNCER_TLS_DIR}/server.key
client_tls_cert_file = ${PGBOUNCER_TLS_DIR}/server.crt
server_tls_sslmode = ${PGBOUNCER_SERVER_TLS_MODE}
server_tls_ca_file = ${PGBOUNCER_TLS_DIR}/database-ca.pem
